GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: models to try, in order, when the main one is overloaded or out of free quota
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: a key from a different Google project gives audio its own free quota. Blank reuses GEMINI_API_KEY.
GEMINI_AUDIO_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
# Comma-separated origins allowed in dev (the Vite dev server)
CORS_ORIGINS=http://localhost:5173
